{
  "name": "tx-moderation-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted SvelteKit moderation dashboard for the tx Discord bot. Runs in-process alongside the bot and uses a typed bridge for live data.",
  "author": "Hyvnt",
  "license": "MIT",
  "homepage": "https://github.com/ishyv/tx-discord-bot-webapp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishyv/tx-discord-bot-webapp.git"
  },
  "bugs": {
    "url": "https://github.com/ishyv/tx-discord-bot-webapp/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "dashboard",
    "moderation",
    "sveltekit",
    "svelte",
    "self-hosted"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyvnt/hyvui": "^0.4.0",
    "@sveltejs/adapter-node": "^5.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "dotenv": "^17.4.2",
    "lucide-svelte": "^0.468.0",
    "mongodb": "^6.8.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.5"
  }
