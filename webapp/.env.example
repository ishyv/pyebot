# tx moderation dashboard environment
#
# Placeholder values only. Keep real credentials in your local environment or
# local dotenv file; do not commit secrets.

# MongoDB used for dashboard sessions and bot-backed data reads.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=tx

# Discord OAuth application credentials.
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:4000/auth/discord/callback

# Long random cookie/session signing secret.
SESSION_SECRET=replace_with_a_long_random_secret

# Optional: comma-separated Discord user IDs allowed to edit RPG content.
BOT_OWNER_IDS=

# Optional: set to 1 for verbose guild-picker server logs.
DEBUG_GUILDS=0
