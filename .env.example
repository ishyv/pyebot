# Required for a real Discord connection.
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id

# Optional for local command registration while developing.
GUILD_ID=

# Optional for starter bots. Required by the bundled full tx-v2 feature set.
MONGO_URI=mongodb://localhost:27017
DB_NAME=txbot

# Optional diagnostics.
DEBUG=
