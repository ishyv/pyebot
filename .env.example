# Discord bot runtime. Required by `bun run doctor`, `bun run dev`, and `bun run start`.
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_client_id

# Optional: use a development guild for fast slash-command registration.
# Leave empty to register global commands.
GUILD_ID=

# MongoDB persistence. Required by the bundled tx-v2 feature set and dashboard.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=tx

# Optional diagnostics. Any non-empty value enables debug logs.
DEBUG=

# Optional content packs. Leave empty to use only bundled TypeScript content.
CONTENT_PACKS_DIR=

# Optional AI providers. Configure at least one key before using AI commands.
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_GENERATIVE_AI_API_KEY is also accepted as a Gemini fallback.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional embedded dashboard. Build `webapp/` first, then set WEBAPP=true to
# start it alongside the bot. WEBAPP_PORT defaults to 4000 when empty.
WEBAPP=true
WEBAPP_PORT=4000

# Discord OAuth credentials for the dashboard.
# DISCORD_CLIENT_ID can usually match CLIENT_ID.
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:4000/auth/discord/callback
SESSION_SECRET=change-me-to-a-long-random-secret
